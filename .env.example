# GitHub Personal Access Token (scope: repo) — используется деплой-скриптами.
# НЕ коммитить реальный токен. Файл .env исключён из git через .gitignore.
GITHUB_TOKEN=

# Android release signing (для release-billiardtracker.mjs)
BT_KEYSTORE_PATH=
BT_KEY_ALIAS=billiardtracker
BT_STORE_PASSWORD=
BT_KEY_PASSWORD=
